# Copy to .env for local overrides. Never commit a real .env file.

# Address the server binds to. Keep 127.0.0.1 unless you add authentication.
HOST=127.0.0.1
PORT=3210

# Where the SQLite database and (later) recipe images are stored.
DATA_DIR=./data

# trace | debug | info | warn | error | fatal | silent
LOG_LEVEL=info

# Required to bind to a non-loopback HOST (e.g. 0.0.0.0 inside Docker).
# Only set to true when something else protects the port (e.g. a 127.0.0.1-only
# port mapping). Password authentication arrives in a later phase.
# ALLOW_INSECURE_NO_AUTH=true
