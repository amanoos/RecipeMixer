# Copy to .env for local overrides. Never commit a real .env file.

# Address the server binds to. Keep 127.0.0.1 unless you add authentication.
HOST=127.0.0.1
PORT=3210

# Where the SQLite database and (later) recipe images are stored.
DATA_DIR=./data

# trace | debug | info | warn | error | fatal | silent
LOG_LEVEL=info

# A password protects the whole API and every photo, and is what makes it reasonable to reach the app from
# anywhere other than your own computer. At least 12 characters; the app refuses weak ones and says how to make
# a good one. Prefer the file form, so the password is not visible in the environment. Set only one of the two.
# Make one with: node -e "console.log(require('node:crypto').randomBytes(18).toString('base64url'))"
# APP_PASSWORD_FILE=/run/secrets/recipemixer_password
# APP_PASSWORD=

# Behind a reverse proxy (HTTPS in front): the proxy's address, as an IP, a range such as 10.0.0.0/8, or
# loopback / uniquelocal. Only requests from there have X-Forwarded-For and X-Forwarded-Proto believed.
# "true" is refused on purpose. Leave unset when nothing sits in front of the app.
# TRUST_PROXY=loopback

# Mark the login cookie Secure even when the proxy does not say the request was HTTPS.
# COOKIE_SECURE=true

# Only used when NO password is set: extra names the app may be opened by (localhost is always allowed).
# ALLOWED_HOSTS=192.168.1.5

# Required to bind to a non-loopback HOST (e.g. 0.0.0.0 inside Docker) WITHOUT a password.
# Only set to true when something else protects the port (e.g. a 127.0.0.1-only port mapping).
# With a password set it is not needed. See docs/DEPLOYMENT.md.
# ALLOW_INSECURE_NO_AUTH=true

# Lets the server fetch recipe pages and photos from links you paste (Import page).
# Set to false to turn the feature off completely.
# URL_IMPORT_ENABLED=true
