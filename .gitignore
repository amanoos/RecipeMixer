# dependencies and build output
node_modules/
dist/
coverage/
.vitest/
*.tsbuildinfo

# user data: never commit databases, images or uploads (anchored, so the bundled server/src/data is not ignored)
/data/
/server/data/
*.db
*.db-wal
*.db-shm
*.sqlite
*.sqlite3
uploads/
images/

# secrets and local config
.env
.env.*
!.env.example

# logs and OS files
*.log
npm-debug.log*
.DS_Store
Thumbs.db

# editor and local tooling
.vscode/
.idea/
.claude/settings.local.json

# demo libraries made by npm run seed:demo
demo-data/

# deployment secrets (the password file for deploy/docker-compose.caddy.yml)
deploy/secrets/

# local compose override (home-network access); holds no secrets but is specific to this machine
docker-compose.override.yml
