{
  "name": "@recipemixer/server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "license": "MIT",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.build.json && node scripts/copy-migrations.mjs",
    "start": "node dist/index.js",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run",
    "bench": "vitest run --config vitest.bench.config.ts",
    "eval:matching": "tsx scripts/eval-matching.ts",
    "eval:import": "tsx scripts/eval-import.ts"
  },
  "dependencies": {
    "@fastify/helmet": "^13.2.0",
    "@fastify/multipart": "^10.1.4",
    "@fastify/rate-limit": "^11.2.1",
    "@fastify/static": "^10.1.6",
    "better-sqlite3": "^13.0.3",
    "fastify": "^5.12.7",
    "parse-ingredient": "^3.0.0",
    "pluralize": "^8.0.0",
    "sharp": "^0.35.5",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^26.6.5",
    "@types/pluralize": "^0.0.33",
    "tsx": "^4.23.15",
    "vitest": "^5.0.5"
  }
}
